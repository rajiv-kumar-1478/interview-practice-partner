# Twilio credentials — obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# LLM provider — OpenAI or any compatible endpoint
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Groq Whisper — speech-to-text transcription
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ElevenLabs — text-to-speech synthesis
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Media serving (set to your public hostname in production, ngrok URL in dev)
MEDIA_BASE_URL=https://your-domain.com
MEDIA_TTL_SECONDS=600